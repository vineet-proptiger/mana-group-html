# ═══════════════════════════════════════════════════
# CLOUDFLARE PAGES / NETLIFY HTTP CACHE HEADERS
# ═══════════════════════════════════════════════════

# 1. ONLY IMAGES ARE CACHED (Browser + CDN Edge Cache for 30 Days)
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  Cloudflare-CDN-Cache-Control: max-age=2592000
  CDN-Cache-Control: max-age=2592000

/favicon/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  Cloudflare-CDN-Cache-Control: max-age=2592000
  CDN-Cache-Control: max-age=2592000

# 2. CSS FILES - STRICT NO-CACHE (Browser aur Cloudflare CDN dono cache nahi karenge)
/css/*
  Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-store
  CDN-Cache-Control: no-store
  Pragma: no-cache
  Expires: 0

/*.css
  Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-store
  CDN-Cache-Control: no-store
  Pragma: no-cache
  Expires: 0

/form.css
  Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-store
  CDN-Cache-Control: no-store
  Pragma: no-cache
  Expires: 0

# 3. JS, HTML & OTHER FILES - STRICT NO-CACHE
/*.js
  Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-store
  CDN-Cache-Control: no-store
  Pragma: no-cache
  Expires: 0

/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-store
  CDN-Cache-Control: no-store
  Pragma: no-cache
  Expires: 0

/
  Cache-Control: no-cache, no-store, must-revalidate
  Cloudflare-CDN-Cache-Control: no-store
  CDN-Cache-Control: no-store
  Pragma: no-cache
  Expires: 0
